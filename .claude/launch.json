{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "desktop",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/desktop",
        "run",
        "dev"
      ],
      "port": 1420
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "apps/mobile",
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081,
      "env": {
        "EXPO_PUBLIC_MOCK": "1",
        "CI": "1"
      }
    }
  ]
}