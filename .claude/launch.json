{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/web",
        "run",
        "dev",
        "--",
        "--port",
        "5199",
        "--strictPort"
      ],
      "port": 5199
    },
    {
      "name": "desktop",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "apps/desktop",
        "run",
        "dev"
      ],
      "port": 1420
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_MOCK=1",
        "npm",
        "--prefix",
        "apps/mobile",
        "run",
        "web",
        "--",
        "--port",
        "8081"
      ],
      "port": 8081
    }
  ]
}