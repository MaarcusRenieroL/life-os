<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.0</version>
		<relativePath/>
	</parent>
	<groupId>com.lifeos</groupId>
	<artifactId>app</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<description>The single runnable life-os backend: every module in one JVM.</description>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>com.lifeos</groupId>
			<artifactId>common</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.lifeos</groupId>
			<artifactId>auth</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.lifeos</groupId>
			<artifactId>vault</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.lifeos</groupId>
			<artifactId>job-tracker</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.lifeos</groupId>
			<artifactId>core</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.lifeos</groupId>
			<artifactId>notes</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.lifeos</groupId>
			<artifactId>finance-tracker</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.lifeos</groupId>
			<artifactId>batches</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.lifeos</groupId>
			<artifactId>habit-tracker</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.lifeos</groupId>
			<artifactId>tasks</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.lifeos</groupId>
			<artifactId>workouts</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>com.lifeos</groupId>
			<artifactId>calendar</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-context-support</artifactId>
		</dependency>
		<dependency>
			<groupId>com.github.ben-manes.caffeine</groupId>
			<artifactId>caffeine</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
