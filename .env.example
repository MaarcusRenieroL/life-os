SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lifeos
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

OLLAMA_URL=http://ollama:11434

# Required secrets: the stack refuses to start if any of these four is empty. Generate each with:
#   openssl rand -base64 32
# Never reuse a value from the git history, and back up this file: losing the two ENCRYPTION secrets
# makes the Gmail tokens and bank account numbers they protect unreadable.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30

API_BASE_URL=http://localhost
API_PORT=8080

ENVIRONMENT=development

# Your timezone (IANA name). The services run in it, so "today", habit reminder times and the scheduled
# jobs (missed-habit logging, morning scans) follow your day instead of UTC.
APP_TIMEZONE=Asia/Kolkata

# Your account id (auth_schema.users.id). Required: Gmail syncs and scheduled jobs file data under it,
# and it is the only account allowed to sign in.
OWNER_USER_ID=
# Generate with: openssl rand -base64 32
INTERNAL_API_KEY=

# Encrypt Gmail OAuth tokens and bank account numbers at rest (AES-256-GCM). Rotate with scripts/rotate-encryption-secrets.sh.
GMAIL_ENCRYPTION_SECRET=
FINANCE_ENCRYPTION_SECRET=

# --- Local AI (free, private) -------------------------------------------------------------------------
# Run Ollama on the Mac itself (brew install ollama && brew services start ollama): inside Docker it has no
# GPU on a Mac and is several times slower. The containers reach it through host.docker.internal.
# Pull the model once with: ollama pull qwen3.5:9b   (see scripts/ai-bench.py to compare models on your own prompts)
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3.5:9b
# Cover letters and referral messages default to Claude; send them to Ollama too if you have no Claude credit.
# AI_ROUTE_COVER_LETTER=ollama
# AI_ROUTE_REFERRAL_MESSAGE=ollama
