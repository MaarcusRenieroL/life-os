SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/lifeos
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

OLLAMA_URL=http://ollama:11434

# Required secrets: the stack refuses to start if any of these four is empty. Generate each with:
#   openssl rand -base64 32
# Never reuse a value from the git history, and back up this file: losing the two ENCRYPTION secrets
# makes the Gmail tokens and bank account numbers they protect unreadable.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30

API_BASE_URL=http://localhost
API_PORT=8080

ENVIRONMENT=development

# Your account id (auth_schema.users.id). Required: Gmail syncs and scheduled jobs file data under it,
# and it is the only account allowed to sign in.
OWNER_USER_ID=
# Generate with: openssl rand -base64 32
INTERNAL_API_KEY=

# Encrypt Gmail OAuth tokens and bank account numbers at rest (AES-256-GCM). Rotate with scripts/rotate-encryption-secrets.sh.
GMAIL_ENCRYPTION_SECRET=
FINANCE_ENCRYPTION_SECRET=
